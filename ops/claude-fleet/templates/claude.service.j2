[Unit]
Description=Claude Code (persistent maintenance agent, run inside tmux for a real pty)
After=network-online.target
Wants=network-online.target

[Service]
# claude is an interactive TUI — it needs a real pty, which Type=simple can't
# provide directly. tmux gives it one; this unit's job is just to (re)create
# that tmux session on boot. The inner `while true` loop restarts claude if
# it ever exits/crashes, since systemd itself only supervises the one-shot
# launch, not what happens inside the tmux session afterward.
Type=oneshot
RemainAfterExit=yes
User=root
Environment="ANTHROPIC_API_KEY={{ anthropic_api_key }}"
Environment="HOME=/root"
WorkingDirectory=/root
ExecStartPre=-/usr/bin/tmux kill-session -t claude-code
ExecStart=/usr/bin/tmux new-session -d -s claude-code "while true; do /usr/bin/claude --permission-mode=auto; sleep 5; done"
ExecStop=/usr/bin/tmux kill-session -t claude-code

[Install]
WantedBy=multi-user.target
